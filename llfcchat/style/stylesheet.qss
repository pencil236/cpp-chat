QDialog#LoginDialog {
    background-color: rgb(255, 255, 255);
}

QLabel#user_label,
QLabel#pass_label {
    color: rgb(32, 32, 32);
}

QLabel#forget_label {
    color: rgb(80, 120, 190);
}

QLineEdit {
    border: 1px solid rgb(205, 205, 205);
    border-radius: 4px;
    padding: 2px 6px;
}

QLineEdit:focus {
    border-color: rgb(80, 140, 220);
}

QPushButton {
    border: 1px solid rgb(185, 185, 185);
    border-radius: 4px;
    background-color: rgb(248, 248, 248);
}

QPushButton:hover {
    background-color: rgb(235, 242, 252);
}

QPushButton:pressed {
    background-color: rgb(220, 232, 248);
}
